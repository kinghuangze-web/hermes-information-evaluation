{
  "name": "hermes-information-evaluation",
  "version": "0.1.0",
  "description": "A Feishu-first multi-agent system for content intake, evaluation, and action routing.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/smoke.test.js",
    "scan:privacy": "node scripts/privacy-scan.js",
    "verify": "npm test && npm run scan:privacy",
    "chrome:session:health": "node scripts/chrome-session-health-check.js",
    "chrome:session:start": "powershell -ExecutionPolicy Bypass -File scripts/start-chrome-session-proxy.ps1"
  },
  "keywords": [
    "hermes",
    "feishu",
    "multi-agent",
    "content-evaluation",
    "browser-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "fs-extra": "^11.1.1",
    "morgan": "^1.10.0",
    "playwright": "^1.54.2",
    "tesseract.js": "^7.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
