# Server
PORT=3000
NODE_ENV=production

# Local storage
HERMES_DATA_DIR=data

# Remote content controls
HERMES_ALLOW_REMOTE_FETCH=true
HERMES_SOURCE_LIBRARY_ENABLED=true

# Agent execution
HERMES_AGENT_EXECUTION_MODE=local_modules
HERMES_AGENT_FALLBACK_LOCAL=true
HERMES_AGENT_WSL_DISTRO=Ubuntu-24.04
HERMES_AGENT_ROOT=/path/to/hermes-agent
HERMES_CONTENT_PROFILE=hermes-content-worker
HERMES_EVALUATION_PROFILE=hermes-evaluation-worker
HERMES_ACTION_PROFILE=hermes-action-worker

# Browser session
HERMES_CHROME_SESSION_ENABLED=true
HERMES_CHROME_PROXY_URL=http://127.0.0.1:3456
HERMES_CHROME_PROXY_AUTOSTART=true
HERMES_CHROME_DEBUG_PORT=9223
HERMES_CHROME_DEVTOOLS_FILE=
HERMES_CHROME_SESSION_AUTORECOVER=true
HERMES_CHROME_SESSION_RECOVER_COMMAND=
HERMES_X_ARTICLE_BROWSER_FALLBACK=true

# Feishu reply
FEISHU_REPLY_ENABLED=false
FEISHU_OPEN_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# Feishu Bitable writer
FEISHU_BITABLE_ENABLED=false
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_BITABLE_CONFIG_PATH=
FEISHU_BITABLE_CONFIG_WSL_PATH=
